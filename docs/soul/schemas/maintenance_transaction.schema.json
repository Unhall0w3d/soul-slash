{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soul.maintenance.transaction.v1",
  "title": "Soul Maintenance Foreground Transaction",
  "type": "object",
  "required": ["schema_version", "transaction_id", "mode", "owner_uid", "deadline_at", "plan_digest", "commands", "reboot_allowed", "result_path"],
  "properties": {
    "schema_version": {"const": "soul.maintenance.transaction.v1"},
    "transaction_id": {"type": "string", "pattern": "^maintenance_tx_[a-f0-9]{16}$"},
    "mode": {"enum": ["rehearsal", "live", "live_reboot"]},
    "owner_uid": {"type": "integer", "minimum": 1},
    "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "handoff_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reboot_allowed": {"type": "boolean"},
    "commands": {"type": "array", "minItems": 1, "maxItems": 4}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soul.maintenance.transaction_result.v1",
  "title": "Soul Maintenance Foreground Transaction Result",
  "type": "object",
  "required": ["schema_version", "transaction_id", "lifecycle_state", "password_prompts", "commands", "sudo_ticket_invalidated", "reboot_requested"],
  "properties": {
    "schema_version": {"const": "soul.maintenance.transaction_result.v1"},
    "transaction_id": {"type": "string", "pattern": "^maintenance_tx_[a-f0-9]{16}$"},
    "lifecycle_state": {"enum": ["complete", "failed", "canceled", "blocked_for_human_review"]},
    "password_prompts": {"type": "integer", "minimum": 0, "maximum": 1},
    "commands": {"type": "array", "maxItems": 8},
    "reboot_requested": {"const": false}
  },
  "additionalProperties": true
}

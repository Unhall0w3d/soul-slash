{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/schemas/codex_subagent_assignment.schema.json",
  "title": "Soul Codex Subagent Assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assignment_id",
    "role",
    "objective",
    "expected_deliverable",
    "scope",
    "acceptance_commands",
    "authority_limits",
    "non_goals",
    "shared_worktree",
    "evidence_required"
  ],
  "properties": {
    "schema_version": { "const": "soul.codex.subagent_assignment.v1" },
    "assignment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,95}$" },
    "role": { "enum": ["mapper", "implementer", "reviewer"] },
    "objective": { "type": "string", "minLength": 3, "maxLength": 1024 },
    "expected_deliverable": { "type": "string", "minLength": 3, "maxLength": 1024 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "paths"],
      "properties": {
        "mode": { "enum": ["read_only", "owned_paths"] },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "acceptance_commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "authority_limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "shared_worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_existing_changes"],
      "properties": { "preserve_existing_changes": { "const": true } }
    },
    "evidence_required": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": ["changed_paths", "commands", "results", "uncertainties", "scope_deviations"]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soul.maintenance.restore_registry.v1",
  "title": "Soul Maintenance Restore Registry",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "soul.maintenance.restore_registry.v1"},
    "entries": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["entry_id", "identities", "process_identities", "argv", "maximum_instances", "title_policy", "startup_policy"],
        "properties": {
          "entry_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
          "argv": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}},
          "process_identities": {"type": "array", "maxItems": 16, "items": {"type": "string"}},
          "maximum_instances": {"type": "integer", "minimum": 1, "maximum": 8},
          "title_policy": {"const": "omit"},
          "startup_policy": {"enum": ["launch_window", "launch_if_absent"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

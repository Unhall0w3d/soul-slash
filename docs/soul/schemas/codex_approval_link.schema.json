{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex approval evidence link",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "link_id", "artifact_path", "decision", "source_kind", "source_reference", "scope", "recorded_at"],
  "properties": {
    "schema_version": {"const": "soul.codex.approval_link.v1"},
    "link_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,95}$"},
    "artifact_path": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "rejected", "changes_requested"]},
    "source_kind": {"enum": ["current_user_message", "signed_review"]},
    "source_reference": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soul.maintenance.plan.v1",
  "title": "Soul Maintenance Plan",
  "type": "object",
  "required": ["schema_version", "plan_id", "risk_class", "commands", "window_snapshot", "execution_authorized", "rehearsal_only"],
  "properties": {
    "schema_version": {"const": "soul.maintenance.plan.v1"},
    "plan_id": {"type": "string", "pattern": "^maintenance_[a-f0-9]{16}$"},
    "risk_class": {"const": "class_5"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["adapter", "argv", "interactive", "executes_in_a1"],
        "properties": {
          "argv": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string"}},
          "executes_in_a1": {"const": false}
        },
        "additionalProperties": true
      }
    },
    "execution_authorized": {"const": false},
    "rehearsal_only": {"const": true}
  },
  "additionalProperties": true
}

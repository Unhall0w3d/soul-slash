[Unit]
Description=Soul demand-loaded roster coordinator
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/bhones/Projects/soul
ExecStart=/home/bhones/.rbenv/versions/4.0.7/bin/ruby /home/bhones/Projects/soul/scripts/soul-roster-coordinator.rb --serve
UMask=0077
Restart=no
TimeoutStopSec=250
KillMode=control-group
Environment=CUDA_VISIBLE_DEVICES=0

[Install]
WantedBy=graphical-session.target

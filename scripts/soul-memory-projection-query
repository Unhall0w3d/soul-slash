#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
load File.expand_path("soul-memory-projection-reconcile", __dir__)
require_relative "../lib/soul_core/memory_projection_query_service"
require_relative "../lib/soul_core/memory_retrieval_service"

module SoulMemoryProjectionQueryCLI
  class UnavailableProjectionDependency
    def method_missing(*) = raise("projection dependency is unavailable")
    def respond_to_missing?(*, **) = true
  end

  module_function

  def run(argv, env: ENV, root: File.expand_path("..", __dir__))
    query = argv.shift.to_s
    limit = argv.empty? ? 8 : Integer(argv.shift)
    return usage unless argv.empty? && !query.strip.empty?

    _local, projection = build_services(env: env, root: root)
    result = projection.query(query: query, limit: limit)
    puts JSON.pretty_generate(result)
    result["lifecycle_state"] == "complete" ? 0 : 1
  rescue StandardError => error
    warn JSON.generate(
      "ok" => false, "lifecycle_state" => "failed",
      "message" => "Memory projection query failed safely: #{error.class}: #{error.message}",
      "mutation" => "none"
    )
    1
  end

  def build_services(env:, root:)
    paths = SoulCore::MemoryPaths.new(root: root)
    projection_root = File.join(paths.private_root, "projection")
    store = SoulCore::ConversationMemoryStore.new(root: root, create: false)
    index_path = paths.write_path("derived/approved-memory-index.json")
    embedding = optional_embedding_client(env)
    index = SoulCore::ApprovedMemoryIndexService.new(
      memory_store: store, index_path: index_path, allowed_root: paths.private_root,
      embedding_client: embedding
    )
    local = SoulCore::ApprovedMemoryRetrievalService.new(
      memory_store: store, index_service: index, embedding_client: embedding,
      query_instruction: env["SOUL_MEMORY_EMBEDDING_QUERY_INSTRUCTION"]
    )
    qdrant, falkor = projection_clients(env, projection_root)
    selector = SoulCore::MemoryProjectionSelectorStore.new(
      private_root: paths.private_root, path: File.join(projection_root, "active-generation.json")
    )
    contract = SoulCore::MemoryProjectionContract.new(memory_store: store, index_service: index)
    projection = SoulCore::MemoryProjectionQueryService.new(
      memory_store: store, embedding_client: embedding || UnavailableProjectionDependency.new, projection_contract: contract,
      selector_store: selector, qdrant_client: qdrant, falkor_client: falkor,
      local_retrieval: local, query_instruction: env["SOUL_MEMORY_EMBEDDING_QUERY_INSTRUCTION"]
    )
    [local, projection, store]
  end

  def embedding_client(env)
    endpoint = env.fetch("SOUL_MEMORY_EMBEDDING_ENDPOINT")
    profile = env.fetch("SOUL_MEMORY_EMBEDDING_PROFILE")
    dimensions = Integer(env.fetch("SOUL_MEMORY_EMBEDDING_DIMENSIONS"))
    SoulCore::LocalLoopbackEmbeddingClient.new(
      endpoint: endpoint,
      profile: {"name" => profile, "dimensions" => dimensions},
      protocol: env.fetch("SOUL_MEMORY_EMBEDDING_PROTOCOL", "ollama")
    )
  end

  def optional_embedding_client(env)
    required = %w[SOUL_MEMORY_EMBEDDING_ENDPOINT SOUL_MEMORY_EMBEDDING_PROFILE SOUL_MEMORY_EMBEDDING_DIMENSIONS]
    return nil unless required.all? { |key| !env[key].to_s.empty? }

    embedding_client(env)
  rescue StandardError
    nil
  end

  def projection_clients(env, projection_root)
    config_path = env.fetch("SOUL_MEMORY_PROJECTION_PRIVATE_CONFIG", File.join(projection_root, "deployment.json"))
    config = SoulMemoryProjectionReconcileCLI.read_private_json(config_path, allowed_root: projection_root)
    SoulMemoryProjectionReconcileCLI.validate_config!(config, projection_root)
    ca_path = SoulMemoryProjectionReconcileCLI.private_regular_path(config.fetch("ca_certificate_path"), allowed_root: projection_root)
    qdrant = SoulCore::QdrantProjectionClient.new(transport: SoulCore::BoundedJsonTlsTransport.new(
      endpoint: "https://#{config.fetch('ipv4')}:6333", ca_path: ca_path,
      headers: {"api-key" => SoulMemoryProjectionReconcileCLI.read_private_text(config.fetch("qdrant_api_key_path"), allowed_root: projection_root)}
    ))
    falkor = SoulCore::FalkorProjectionClient.new(command_client: SoulCore::RedisTlsCommandClient.new(
      host: config.fetch("ipv4"), port: 6379, ca_path: ca_path,
      password: SoulMemoryProjectionReconcileCLI.read_private_text(config.fetch("falkordb_password_path"), allowed_root: projection_root)
    ))
    [qdrant, falkor]
  rescue StandardError
    unavailable = UnavailableProjectionDependency.new
    [unavailable, unavailable]
  end

  def usage
    warn "Usage: ruby scripts/soul-memory-projection-query 'QUERY' [LIMIT]"
    2
  end
end

exit SoulMemoryProjectionQueryCLI.run(ARGV) if $PROGRAM_NAME == __FILE__

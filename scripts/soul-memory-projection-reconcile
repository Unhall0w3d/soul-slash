#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "ipaddr"
require "pathname"
require_relative "../lib/soul_core/conversation_memory_store"
require_relative "../lib/soul_core/memory_paths"
require_relative "../lib/soul_core/memory_projection_contract"
require_relative "../lib/soul_core/memory_projection_reconciler"
require_relative "../lib/soul_core/memory_projection_transports"
require_relative "../lib/soul_core/memory_retrieval_index"

module SoulMemoryProjectionReconcileCLI
  module_function

  MAX_PRIVATE_FILE_BYTES = 128 * 1024

  def run(argv, env: ENV, root: File.expand_path("..", __dir__))
    command = argv.shift.to_s
    return usage unless %w[preview execute].include?(command)
    return usage unless (command == "preview" && argv.empty?) || (command == "execute" && argv.length == 2)

    paths = SoulCore::MemoryPaths.new(root: root)
    projection_root = File.join(paths.private_root, "projection")
    config_path = env.fetch("SOUL_MEMORY_PROJECTION_PRIVATE_CONFIG", File.join(projection_root, "deployment.json"))
    config = read_private_json(config_path, allowed_root: projection_root)
    validate_config!(config, projection_root)

    store = SoulCore::ConversationMemoryStore.new(root: root, create: false)
    index_path = paths.write_path("derived/approved-memory-index.json")
    index_envelope = read_private_json(index_path, allowed_root: paths.private_root, max_bytes: 128 * 1024 * 1024)
    index = SoulCore::ApprovedMemoryIndexService.new(
      memory_store: store,
      index_path: index_path,
      allowed_root: paths.private_root,
      embedding_profile: index_envelope.fetch("embedding_profile"),
      dimensions: index_envelope.fetch("dimensions")
    )

    qdrant_key = read_private_text(config.fetch("qdrant_api_key_path"), allowed_root: projection_root)
    falkor_password = read_private_text(config.fetch("falkordb_password_path"), allowed_root: projection_root)
    ca_path = private_regular_path(config.fetch("ca_certificate_path"), allowed_root: projection_root)
    host = config.fetch("ipv4")
    qdrant_transport = SoulCore::BoundedJsonTlsTransport.new(
      endpoint: "https://#{host}:6333",
      ca_path: ca_path,
      headers: {"api-key" => qdrant_key}
    )
    qdrant = SoulCore::QdrantProjectionClient.new(transport: qdrant_transport)
    falkor_commands = SoulCore::RedisTlsCommandClient.new(
      host: host,
      port: 6379,
      ca_path: ca_path,
      password: falkor_password
    )
    falkor = SoulCore::FalkorProjectionClient.new(command_client: falkor_commands)
    selector = SoulCore::MemoryProjectionSelectorStore.new(
      private_root: paths.private_root,
      path: File.join(projection_root, "active-generation.json")
    )
    reconciler = SoulCore::MemoryProjectionReconciler.new(
      contract: SoulCore::MemoryProjectionContract.new(memory_store: store, index_service: index),
      qdrant_client: qdrant,
      falkor_client: falkor,
      selector_store: selector
    )

    result = command == "preview" ? reconciler.preview : reconciler.execute(
      confirmation: argv.shift.to_s,
      expected_digest: argv.shift.to_s
    )
    puts JSON.pretty_generate(result)
    result.fetch("ok") ? 0 : (result.fetch("lifecycle_state") == "blocked_for_human_review" ? 2 : 1)
  rescue StandardError => error
    warn JSON.generate(
      "ok" => false,
      "lifecycle_state" => "failed",
      "reason" => "Memory projection command failed safely: #{error.class}: #{error.message}",
      "data" => {"content_included" => false, "fallback" => "local_authoritative_retrieval"},
      "mutation" => "none"
    )
    1
  end

  def read_private_json(path, allowed_root:, max_bytes: MAX_PRIVATE_FILE_BYTES)
    JSON.parse(read_private_text(path, allowed_root: allowed_root, max_bytes: max_bytes))
  rescue JSON::ParserError
    raise "private JSON is malformed"
  end

  def read_private_text(path, allowed_root:, max_bytes: MAX_PRIVATE_FILE_BYTES)
    resolved = private_regular_path(path, allowed_root: allowed_root)
    raise "private file exceeds byte bound" if File.size(resolved) > max_bytes

    value = File.binread(resolved).strip
    raise "private file is empty" if value.empty?

    value
  end

  def private_regular_path(path, allowed_root:)
    root = File.expand_path(allowed_root)
    value = File.expand_path(path.to_s)
    raise "private path escapes projection state" unless value.start_with?("#{root}#{File::SEPARATOR}")

    current = Pathname.new(root)
    relative = Pathname.new(value).relative_path_from(current)
    [current, *relative.each_filename.map { |name| current = current.join(name) }].each do |component|
      raise "private path contains a symlink component" if File.symlink?(component.to_s)
    end
    raise "private path is not a regular file" unless File.file?(value)
    raise "private path permissions are too broad" unless (File.stat(value).mode & 0o077).zero?

    value
  rescue ArgumentError
    raise "private path escapes projection state"
  end

  def validate_config!(config, projection_root)
    raise "private deployment configuration is invalid" unless config.is_a?(Hash)
    raise "private deployment configuration schema mismatch" unless config["schema_version"] == "soul.memory-projection.private.a20.v1"
    host = config.fetch("fqdn").to_s
    raise "private projection host is invalid" unless host.match?(/\A[a-z0-9][a-z0-9.-]{1,252}[a-z0-9]\z/)
    address = IPAddr.new(config.fetch("ipv4").to_s)
    raise "private projection address is invalid" unless address.ipv4? && address.private?
    %w[ca_certificate_path qdrant_api_key_path falkordb_password_path].each do |key|
      private_regular_path(config.fetch(key), allowed_root: projection_root)
    end
  end

  def usage
    warn "Usage: ruby scripts/soul-memory-projection-reconcile preview|execute REBUILD_MEMORY_PROJECTION EXPECTED_DIGEST"
    2
  end
end

exit SoulMemoryProjectionReconcileCLI.run(ARGV) if $PROGRAM_NAME == __FILE__

#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "open3"
require "optparse"

CONFIRMATION = "INSTALL_SOUL_RNNOISE_FILTER"
FILTER_NAME = "effect_output.soul-rnnoise"
SOURCE_PATTERN = /\A[a-zA-Z0-9_.:-]{1,240}\z/

options = {
  config_root: ENV.fetch("SOUL_PIPEWIRE_CONFIG_ROOT", File.join(Dir.home, ".config", "pipewire")),
  source: nil,
  expected_digest: nil,
  confirmation: nil,
  skip_restart: ENV["SOUL_RNNOISE_SKIP_RESTART"] == "1"
}
OptionParser.new do |parser|
  parser.on("--config-root PATH") { |value| options[:config_root] = value }
  parser.on("--source NAME") { |value| options[:source] = value }
  parser.on("--expected-digest SHA256") { |value| options[:expected_digest] = value }
  parser.on("--confirmation PHRASE") { |value| options[:confirmation] = value }
end.parse!
action = ARGV.shift

def command(*argv)
  output, status = Open3.capture2e(*argv)
  [output, status.success?]
end

def emit(value, status = 0)
  puts JSON.pretty_generate(value)
  exit status
end

def filter_configuration(source)
  <<~CONF
    # Generated by Soul/ after exact Operator review.
    context.modules = [
        { name = libpipewire-module-filter-chain
            flags = [ nofail ]
            args = {
                node.description = "Soul Noise-Cancelled Microphone"
                media.name = "Soul Noise-Cancelled Microphone"
                filter.graph = {
                    nodes = [
                        {
                            type = ladspa
                            name = rnnoise
                            plugin = "librnnoise_ladspa"
                            label = noise_suppressor_mono
                            control = { "VAD Threshold (%)" = 50.0 }
                        }
                    ]
                }
                audio.position = [ MONO ]
                capture.props = {
                    node.name = "effect_input.soul-rnnoise"
                    node.passive = true
                    target.object = "#{source}"
                }
                playback.props = {
                    node.name = "effect_output.soul-rnnoise"
                    node.description = "Soul Noise-Cancelled Microphone"
                    media.class = Audio/Source
                }
            }
        }
    ]
  CONF
end

begin
  destination = File.join(File.expand_path(options[:config_root]), "pipewire.conf.d", "99-soul-rnnoise.conf")
  source = options[:source].to_s
  if source.empty?
    source, ok = command("pactl", "get-default-source")
    raise "current default microphone could not be identified" unless ok
    source = source.strip
    if source == FILTER_NAME && File.file?(destination) && !File.symlink?(destination)
      persisted = File.binread(destination, 64 * 1024)
      source = persisted[/target\.object\s*=\s*"([^"]+)"/, 1].to_s
    end
  end
  source = source.strip
  raise "reviewed microphone source is invalid" unless source.match?(SOURCE_PATTERN)
  raise "a monitor source cannot be used as the microphone input" if source.end_with?(".monitor")
  plugin = "/usr/lib/ladspa/librnnoise_ladspa.so"
  raise "RNNoise LADSPA plugin is missing" unless File.file?(plugin) && !File.symlink?(plugin)

  configuration = filter_configuration(source)
  scope = {
    "operation" => "voice_noise_filter_install",
    "source" => source,
    "filter_source" => FILTER_NAME,
    "destination" => destination,
    "configuration_sha256" => Digest::SHA256.hexdigest(configuration),
    "plugin" => plugin,
    "vad_threshold_percent" => 50.0,
    "restart_existing_user_audio_stack" => !options[:skip_restart],
    "new_service" => false,
    "confirmation_phrase" => CONFIRMATION
  }
  scope["expected_digest"] = Digest::SHA256.hexdigest(JSON.generate(scope))

  if action == "plan"
    emit(scope.merge("lifecycle_state" => "blocked_for_human_review"))
  elsif action == "check"
    configured = File.file?(destination) && !File.symlink?(destination) && File.binread(destination) == configuration
    sources, listed = command("pactl", "list", "short", "sources")
    active = listed && sources.lines.any? { |line| line.split(/\s+/, 3)[1] == FILTER_NAME }
    default, default_ok = command("pactl", "get-default-source")
    emit(
      "lifecycle_state" => configured && active && default_ok && default.strip == FILTER_NAME ? "complete" : "blocked_for_human_review",
      "configured" => configured, "active" => active,
      "default" => default_ok ? default.strip : nil, "source" => source,
      "filter_source" => FILTER_NAME
    )
  end

  raise "action must be plan, check, or install" unless action == "install"
  raise "review the current plan and provide its exact EXPECTED_DIGEST" unless options[:expected_digest] == scope.fetch("expected_digest")
  raise "exact confirmation #{CONFIRMATION} is required" unless options[:confirmation] == CONFIRMATION
  raise "noise-filter configuration already exists; inspect it rather than overwriting" if File.exist?(destination) || File.symlink?(destination)

  FileUtils.mkdir_p(File.dirname(destination), mode: 0o700)
  File.open(destination, File::WRONLY | File::CREAT | File::EXCL, 0o600) { |file| file.write(configuration) }
  if options[:skip_restart]
    emit("lifecycle_state" => "complete", "configured" => true, "activated" => false, "destination" => destination)
  end

  _, restarted = command("systemctl", "--user", "restart", "pipewire.service", "pipewire-pulse.service", "wireplumber.service")
  raise "existing user audio stack restart failed" unless restarted
  sleep 1
  sources, listed = command("pactl", "list", "short", "sources")
  active = listed && sources.lines.any? { |line| line.split(/\s+/, 3)[1] == FILTER_NAME }
  raise "RNNoise virtual microphone did not become active" unless active
  _, selected = command("pactl", "set-default-source", FILTER_NAME)
  raise "RNNoise virtual microphone could not become the default source" unless selected
  _, gained = command("pactl", "set-source-volume", FILTER_NAME, "100%")
  raise "RNNoise virtual microphone output gain could not be normalized" unless gained
  emit(
    "lifecycle_state" => "complete", "configured" => true, "activated" => true,
    "source" => source, "filter_source" => FILTER_NAME, "output_gain_percent" => 100,
    "destination" => destination
  )
rescue Interrupt
  FileUtils.rm_f(destination) if defined?(destination) && destination && File.file?(destination)
  emit({ "lifecycle_state" => "canceled", "error" => "installation canceled and generated configuration removed" }, 2)
rescue StandardError => error
  if action == "install" && defined?(destination) && destination && File.file?(destination)
    FileUtils.rm_f(destination)
    command("systemctl", "--user", "restart", "pipewire.service", "pipewire-pulse.service", "wireplumber.service") unless options[:skip_restart]
  end
  emit({ "lifecycle_state" => "failed", "error" => error.message }, 1)
end

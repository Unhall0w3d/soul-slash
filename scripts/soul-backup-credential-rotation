#!/usr/bin/env ruby
# frozen_string_literal: true

require "io/console"
require "json"

require_relative "../lib/soul_core/backup_credential_rotation_service"
require_relative "../lib/soul_core/dotenv_reader"

ROOT = File.expand_path("..", __dir__)
dotenv = SoulCore::DotenvReader.new(root: ROOT).read
abort("Private backup configuration could not be read safely.") unless dotenv.ok?
configuration = dotenv.values

local_repository = configuration.fetch("SOUL_BACKUP_REPOSITORY", "/mnt/soul-backup/restic")
replica_alias = configuration.fetch("SOUL_BACKUP_REPLICA_SSH_ALIAS", "crucible-maintenance")
replica_path = configuration.fetch("SOUL_BACKUP_REPLICA_TARGET_PATH", "/srv/soul-backup/restic")
replica_repository = configuration.fetch("SOUL_BACKUP_REPLICA_REPOSITORY", "sftp:#{replica_alias}:#{replica_path}")
expected_replica = "sftp:#{replica_alias}:#{replica_path}"
abort("Configured replica repository does not match the fixed SSH alias and target path.") unless replica_repository == expected_replica

service = SoulCore::BackupCredentialRotationService.new(
  repositories: [
    {"label" => "Local recovery repository", "repository" => local_repository},
    {"label" => "Crucible second-copy repository", "repository" => replica_repository}
  ],
  lock_path: File.join(ROOT, "Soul", "private", "backup", "operation.lock")
)
action = ARGV.shift.to_s
if action == "plan"
  puts JSON.pretty_generate(service.plan)
  exit 0
end
abort("Usage: scripts/soul-backup-credential-rotation plan|rotate") unless action == "rotate"
abort("Credential rotation requires an interactive terminal.") unless $stdin.tty? && $stdout.tty?

puts "Soul/ Backup Credential Rotation"
puts
puts "This bounded operation changes the single access key on both configured repositories."
puts "It verifies repository identity, snapshot inventory, and rejection of the old password."
puts "No password is stored in a file, receipt, process argument, browser, or Git."
puts
old_password = new_password = new_confirmation = nil
exit_status = 1
begin
  print "Type ROTATE_BACKUP_CREDENTIALS to continue: "
  confirmation = $stdin.gets.to_s.chomp
  abort("Exact confirmation was not supplied; no repository was changed.") unless confirmation == "ROTATE_BACKUP_CREDENTIALS"

  prompt_secret = lambda do |label|
    print label
    value = $stdin.noecho(&:gets).to_s.chomp
    puts
    value
  end
  old_password = prompt_secret.call("Current repository password: ")
  new_password = prompt_secret.call("New repository password (16+ characters): ")
  new_confirmation = prompt_secret.call("Confirm new repository password: ")
  abort("New password confirmation does not match; no repository was changed.") unless new_password == new_confirmation

  result = service.rotate(old_password: old_password, new_password: new_password)
  puts
  puts result.fetch("message")
  Array(result.dig("data", "repositories")).each do |repository|
    puts "- #{repository.fetch("label")}: #{repository.fetch("snapshot_count")} snapshots preserved; old password rejected"
  end
  warn JSON.pretty_generate(result.fetch("data")) unless result.fetch("ok")
  exit_status = result.fetch("ok") ? 0 : 1
ensure
  [old_password, new_password, new_confirmation].compact.each { |value| value.replace("\0" * value.bytesize) }
end
exit exit_status

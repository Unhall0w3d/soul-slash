#!/usr/bin/ruby
# frozen_string_literal: true

# This file is a source template. It is inert in the repository. The A4
# deployment plan replaces every marked token, then installs the result root-owned.

require "digest"
require "fileutils"
require "json"
require "time"
require "timeout"

VERSION = @@VERSION@@
PROJECT_ROOT = @@PROJECT_ROOT@@
OWNER_UID = Integer(@@OWNER_UID@@)
OWNER_GID = Integer(@@OWNER_GID@@)
OWNER_NAME = @@OWNER_NAME@@
OWNER_HOME = @@OWNER_HOME@@
QUALIFIED_HOSTNAME = @@HOSTNAME@@
QUALIFIED_YAY_VERSION = @@YAY_VERSION@@
MAX_SUDO_ANCESTRY_DEPTH = 3

HELPER_PATH = "/usr/local/libexec/soul-maintenance-authority"
STATE_ROOT = "/run/soul-maintenance-authority"
TRANSACTIONS_ROOT = File.join(PROJECT_ROOT, "Soul", "private", "host_maintenance", "transactions")
PENDING_RESTORE = File.join(PROJECT_ROOT, "Soul", "private", "host_maintenance", "pending_restore.json")
TRANSACTION_SCHEMA = "soul.maintenance.transaction.v1"
TRANSACTION_PATTERN = /\Amaintenance_tx_[a-f0-9]{16}\z/
MAX_TRANSACTION_BYTES = 512 * 1024
MAX_RUNTIME_SECONDS = 4 * 60 * 60
PATHS = {
  "yay" => "/usr/bin/yay",
  "sudo" => "/usr/bin/sudo",
  "pacman" => "/usr/bin/pacman",
  "flatpak" => "/usr/bin/flatpak",
  "systemctl" => "/usr/bin/systemctl",
  "makepkg" => "/usr/bin/makepkg",
  "git" => "/usr/bin/git",
  "gpg" => "/usr/bin/gpg",
  "false" => "/usr/bin/false"
}.freeze

def fail_closed(message, code = 2)
  warn("Soul maintenance authority refused: #{message.to_s.byteslice(0, 400)}")
  exit(code)
end

def current_hostname
  File.read("/proc/sys/kernel/hostname", 256).strip
end

def current_boot_id
  File.read("/proc/sys/kernel/random/boot_id", 128).strip
end

def process_identity(pid)
  numeric = Integer(pid)
  raw = File.binread("/proc/#{numeric}/stat", 16 * 1024)
  close = raw.rindex(")")
  fail_closed("process identity is invalid") unless close
  fields = raw[(close + 2)..].split
  {
    "pid" => numeric,
    "ppid" => Integer(fields.fetch(1)),
    "start_ticks" => fields.fetch(19),
    "exe" => File.realpath("/proc/#{numeric}/exe")
  }
rescue ArgumentError, Errno::ENOENT, IndexError
  fail_closed("process identity is unavailable")
end

def helper_digest
  Digest::SHA256.file(HELPER_PATH).hexdigest
end

def verify_caller!
  fail_closed("authority must run as root") unless Process.euid.zero?
  fail_closed("qualified host does not match") unless current_hostname == QUALIFIED_HOSTNAME
  fail_closed("sudo owner UID does not match") unless ENV["SUDO_UID"].to_s == OWNER_UID.to_s
  fail_closed("sudo owner name does not match") unless ENV["SUDO_USER"].to_s == OWNER_NAME
  fail_closed("sudo command identity is missing") if ENV["SUDO_COMMAND"].to_s.empty?
  PATHS.each { |name, path| fail_closed("#{name} path is unavailable") unless File.file?(path) && File.executable?(path) }
end

def read_bounded_json(path, expected_owner:)
  flags = File::RDONLY
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  file = File.open(path, flags)
  stat = file.stat
  fail_closed("state is not a regular file") unless stat.file?
  fail_closed("state owner is invalid") unless stat.uid == expected_owner
  fail_closed("state mode is too broad") unless (stat.mode & 0o077).zero?
  fail_closed("state exceeds its size bound") unless stat.size.between?(2, MAX_TRANSACTION_BYTES)
  JSON.parse(file.read(MAX_TRANSACTION_BYTES))
rescue Errno::ELOOP, Errno::ENOENT, JSON::ParserError
  fail_closed("state is unavailable or invalid")
ensure
  file&.close
end

def transaction_for(id)
  fail_closed("transaction ID is invalid") unless id.match?(TRANSACTION_PATTERN)
  transaction = read_bounded_json(File.join(TRANSACTIONS_ROOT, "#{id}.json"), expected_owner: OWNER_UID)
  fail_closed("transaction schema is invalid") unless transaction["schema_version"] == TRANSACTION_SCHEMA
  fail_closed("transaction ID does not match") unless transaction["transaction_id"] == id
  fail_closed("transaction owner is invalid") unless transaction["owner_uid"] == OWNER_UID
  fail_closed("authority mode is invalid") unless transaction["authority_mode"] == "root_owned_passwordless"
  fail_closed("transaction mode is invalid") unless %w[live live_reboot].include?(transaction["mode"])
  fail_closed("plan digest is invalid") unless transaction["plan_digest"].to_s.match?(/\A[a-f0-9]{64}\z/)
  deadline = Time.iso8601(transaction.fetch("deadline_at"))
  now = Time.now.utc
  fail_closed("transaction deadline is invalid") unless deadline > now && deadline <= now + MAX_RUNTIME_SECONDS + 60
  fail_closed("transaction boot identity changed") unless transaction["source_boot_id"] == current_boot_id
  transaction
rescue KeyError, ArgumentError
  fail_closed("transaction fields are invalid")
end

def expected_operations(transaction)
  operations = transaction.fetch("commands").filter_map do |command|
    case command["adapter"]
    when "arch_and_aur.full_upgrade" then "arch-update"
    when "flatpak.system_update" then "flatpak-system-update"
    when "flatpak.user_update" then nil
    else fail_closed("transaction contains an unsupported adapter")
    end
  end
  operations << "reboot" if transaction["mode"] == "live_reboot"
  fail_closed("transaction privileged operation count is invalid") unless operations.length.between?(1, 3)
  operations
rescue KeyError, NoMethodError
  fail_closed("transaction command list is invalid")
end

def expected_vector(operation, id)
  ["/usr/bin/sudo", "-n", HELPER_PATH, operation, id]
end

def validate_vectors!(transaction, operations, id)
  commands = transaction.fetch("commands")
  commands.each do |command|
    adapter = command.fetch("adapter")
    argv = command.fetch("argv")
    expected = case adapter
    when "arch_and_aur.full_upgrade"
      expected_vector("arch-update", id)
    when "flatpak.system_update"
      expected_vector("flatpak-system-update", id)
    when "flatpak.user_update"
      ["/usr/bin/flatpak", "update", "--user", "--noninteractive"]
    end
    fail_closed("transaction command vector is invalid") unless expected && argv == expected
    fail_closed("transaction shell boundary is invalid") unless command["shell"] == false
  end
  if transaction["mode"] == "live_reboot"
    fail_closed("reboot vector is invalid") unless transaction["reboot_argv"] == expected_vector("reboot", id)
  else
    fail_closed("A2 transaction contains reboot authority") if transaction.key?("reboot_argv")
  end
  fail_closed("operation list changed") unless operations == expected_operations(transaction)
rescue KeyError, NoMethodError
  fail_closed("transaction vector fields are invalid")
end

def state_path(id)
  File.join(STATE_ROOT, "#{id}.json")
end

def load_or_create_state(transaction, operations)
  FileUtils.mkdir_p(STATE_ROOT, mode: 0o700)
  File.chown(0, 0, STATE_ROOT)
  File.chmod(0o700, STATE_ROOT)
  path = state_path(transaction.fetch("transaction_id"))
  return read_bounded_json(path, expected_owner: 0) if File.exist?(path)
  state = {
    "version" => VERSION,
    "transaction_id" => transaction.fetch("transaction_id"),
    "plan_digest" => transaction.fetch("plan_digest"),
    "source_boot_id" => transaction.fetch("source_boot_id"),
    "operations" => operations,
    "next_index" => 0,
    "terminal" => false
  }
  atomic_root_json(path, state)
  state
end

def atomic_root_json(path, value)
  body = JSON.generate(value) + "\n"
  temporary = "#{path}.tmp-#{Process.pid}"
  File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
    file.write(body)
    file.flush
    file.fsync
  end
  File.chown(0, 0, temporary)
  File.chmod(0o600, temporary)
  File.rename(temporary, path)
ensure
  FileUtils.rm_f(temporary) if defined?(temporary)
end

def validate_phase!(state, transaction, operations, requested)
  fail_closed("authority state version changed") unless state["version"] == VERSION
  fail_closed("authority state transaction changed") unless state["transaction_id"] == transaction["transaction_id"]
  fail_closed("authority state plan changed") unless state["plan_digest"] == transaction["plan_digest"]
  fail_closed("authority state boot changed") unless state["source_boot_id"] == current_boot_id
  fail_closed("authority state operation list changed") unless state["operations"] == operations
  fail_closed("transaction is already terminal") if state["terminal"] == true
  index = Integer(state.fetch("next_index"))
  fail_closed("privileged operation is out of sequence") unless operations[index] == requested
  index
rescue KeyError, ArgumentError
  fail_closed("authority state is invalid")
end

def sanitized_environment
  {
    "PATH" => "/usr/local/sbin:/usr/local/bin:/usr/bin",
    "HOME" => OWNER_HOME,
    "USER" => OWNER_NAME,
    "LOGNAME" => OWNER_NAME,
    "SUDO_USER" => OWNER_NAME,
    "SUDO_UID" => OWNER_UID.to_s,
    "SUDO_GID" => ENV.fetch("SUDO_GID"),
    "LANG" => "C.UTF-8",
    "LC_ALL" => "C.UTF-8",
    "XDG_CACHE_HOME" => File.join(OWNER_HOME, ".cache"),
    "XDG_CONFIG_HOME" => File.join(STATE_ROOT, "empty-config")
  }
rescue KeyError
  fail_closed("sudo group identity is missing")
end

def yay_version
  output = IO.popen([sanitized_environment, PATHS.fetch("yay"), "--version", {unsetenv_others: true}], &:read)
  output.to_s[/yay v?([0-9]+\.[0-9]+\.[0-9]+)/, 1].to_s
rescue SystemCallError
  ""
end

def command_for(operation, transaction)
  case operation
  when "arch-update"
    fail_closed("qualified yay version changed") unless yay_version == QUALIFIED_YAY_VERSION
    refresh = transaction["force_database_refresh"] == true ? "-Syyu" : "-Syu"
    [
      PATHS.fetch("yay"),
      "--pacman", PATHS.fetch("pacman"),
      "--makepkg", PATHS.fetch("makepkg"),
      "--git", PATHS.fetch("git"),
      "--gpg", PATHS.fetch("gpg"),
      "--sudo", PATHS.fetch("sudo"),
      "--sudoflags", "-n #{HELPER_PATH} pacman-bridge #{transaction.fetch('transaction_id')}",
      "--config", "/etc/pacman.conf",
      "--builddir", File.join(OWNER_HOME, ".cache", "yay"),
      "--editor", PATHS.fetch("false"),
      "--noconfirm",
      "--answerclean", "None",
      "--answerdiff", "None",
      "--answeredit", "None",
      "--answerupgrade", "All",
      "--noremovemake",
      "--pgpfetch=false",
      "--provides=false",
      "--useask=false",
      "--sudoloop=false",
      refresh
    ]
  when "flatpak-system-update"
    [PATHS.fetch("flatpak"), "update", "--system", "--noninteractive"]
  when "reboot"
    fail_closed("reboot is not authorized by this transaction") unless transaction["mode"] == "live_reboot"
    journal = read_bounded_json(PENDING_RESTORE, expected_owner: OWNER_UID)
    fail_closed("pending reboot journal does not match") unless
      journal["transaction_id"] == transaction["transaction_id"] &&
      journal["source_boot_id"] == transaction["source_boot_id"] &&
      journal["current_state"] == "reboot_requested"
    [PATHS.fetch("systemctl"), "reboot"]
  else
    fail_closed("operation is not allowlisted")
  end
end

def pacman_bridge_operation(arguments)
  explicit_prefix = ["-D", "--asexplicit", "-q", "--noconfirm", "--config", "/etc/pacman.conf", "--"]
  explicit_targets = arguments.drop(explicit_prefix.length)
  mark_explicit =
    arguments.first(explicit_prefix.length) == explicit_prefix &&
    explicit_targets.length.between?(1, 128) &&
    explicit_targets.all? { |target| target.match?(/\A[a-z0-9@._+:-]+\z/) }
  return "mark_explicit" if mark_explicit
  return "package_mutation" if arguments.any? { |part| part == "-S" || part.start_with?("-S") || part == "-U" || part.start_with?("-U") }

  nil
end

def validate_pacman_bridge!(state, transaction, operations, argv)
  index = validate_phase!(state, transaction, operations, "arch-update")
  fail_closed("pacman bridge is outside the active Arch/AUR operation") unless index == state["next_index"]
  active = state["active_arch_update"]
  fail_closed("pacman bridge has no active yay owner") unless active.is_a?(Hash)

  yay = process_identity(active.fetch("yay_pid"))
  fail_closed("active yay process identity changed") unless
    yay["start_ticks"] == active["yay_start_ticks"] &&
    yay["exe"] == File.realpath(PATHS.fetch("yay"))

  ancestor = process_identity(Process.ppid)
  ancestry_matches = false
  (MAX_SUDO_ANCESTRY_DEPTH + 1).times do
    if ancestor["pid"] == yay["pid"]
      ancestry_matches =
        ancestor["start_ticks"] == yay["start_ticks"] &&
        ancestor["exe"] == yay["exe"]
      break
    end
    break unless ancestor["exe"] == File.realpath(PATHS.fetch("sudo"))

    ancestor = process_identity(ancestor["ppid"])
  end
  fail_closed("pacman bridge is not descended through bounded sudo ancestry from active yay") unless ancestry_matches

  fail_closed("pacman bridge command is empty") unless argv.is_a?(Array) && argv.length.between?(2, 256)
  fail_closed("pacman bridge executable changed") unless argv.first == PATHS.fetch("pacman")
  fail_closed("pacman bridge argument is too large") unless argv.all? { |part| part.is_a?(String) && part.bytesize.between?(1, 4096) && !part.include?("\0") }
  arguments = argv.drop(1)
  operation = pacman_bridge_operation(arguments)
  fail_closed("pacman bridge operation is not mutation-bounded") unless operation
  forbidden = %w[-R --remove -D --database --root --sysroot --dbpath --cachedir --hookdir --logfile --gpgdir]
  unless operation == "mark_explicit"
    fail_closed("pacman bridge contains a forbidden operation") if arguments.any? { |part| forbidden.include?(part) || forbidden.any? { |token| part.start_with?("#{token}=") } }
  end
  argv.each_with_index do |part, offset|
    next unless part == "--config"
    fail_closed("pacman bridge configuration changed") unless argv[offset + 1] == "/etc/pacman.conf"
  end
  argv
rescue KeyError, ArgumentError
  fail_closed("pacman bridge state is invalid")
end

def execute_yay_as_owner(argv, deadline, state, id)
  gate_read, gate_write = IO.pipe
  pid = fork do
    gate_write.close
    Process.initgroups(OWNER_NAME, OWNER_GID)
    Process::GID.change_privilege(OWNER_GID)
    Process::UID.change_privilege(OWNER_UID)
    gate_read.read(1)
    gate_read.close
    exec(sanitized_environment, *argv, unsetenv_others: true, in: $stdin, out: $stdout, err: $stderr)
  end
  gate_read.close
  identity = process_identity(pid)
  state["active_arch_update"] = {
    "yay_pid" => pid,
    "yay_start_ticks" => identity.fetch("start_ticks")
  }
  atomic_root_json(state_path(id), state)
  gate_write.write(".")
  gate_write.close

  remaining = deadline - Time.now.utc
  fail_closed("transaction deadline expired") unless remaining.positive?
  status = nil
  Timeout.timeout([remaining, MAX_RUNTIME_SECONDS].min) { _pid, status = Process.wait2(pid) }
  status.exitstatus || 1
rescue Timeout::Error
  Process.kill("TERM", pid) rescue nil
  Process.wait(pid) rescue nil
  124
rescue SystemCallError
  127
ensure
  gate_read&.close rescue nil
  gate_write&.close rescue nil
  state.delete("active_arch_update") if state
  atomic_root_json(state_path(id), state) if state && id
end

def execute_fixed(argv, deadline)
  remaining = deadline - Time.now.utc
  fail_closed("transaction deadline expired") unless remaining.positive?
  pid = Process.spawn(sanitized_environment, *argv, unsetenv_others: true, in: $stdin, out: $stdout, err: $stderr)
  status = nil
  Timeout.timeout([remaining, MAX_RUNTIME_SECONDS].min) { _pid, status = Process.wait2(pid) }
  status.exitstatus || 1
rescue Timeout::Error
  Process.kill("TERM", pid) rescue nil
  Process.wait(pid) rescue nil
  124
rescue SystemCallError
  127
end

verify_caller!
operation = ARGV.shift.to_s

if operation == "self-check"
  fail_closed("self-check accepts no arguments") unless ARGV.empty?
  puts JSON.generate({
    "version" => VERSION,
    "helper_sha256" => helper_digest,
    "owner_uid" => OWNER_UID,
    "hostname" => QUALIFIED_HOSTNAME,
    "password_storage" => false,
    "arbitrary_command_forwarding" => false
  })
  exit(0)
end

id = ARGV.shift.to_s
if operation == "pacman-bridge"
  fail_closed("pacman bridge argument count is invalid") if ARGV.empty?
  transaction = transaction_for(id)
  operations = expected_operations(transaction)
  validate_vectors!(transaction, operations, id)
  state = load_or_create_state(transaction, operations)
  deadline = Time.iso8601(transaction.fetch("deadline_at"))
  status = execute_fixed(validate_pacman_bridge!(state, transaction, operations, ARGV), deadline)
  fail_closed("pacman bridge failed with status #{status}", status.zero? ? 1 : status) unless status.zero?
  exit(0)
end

fail_closed("argument count is invalid") unless ARGV.empty?
transaction = transaction_for(id)
operations = expected_operations(transaction)
validate_vectors!(transaction, operations, id)
state = load_or_create_state(transaction, operations)
index = validate_phase!(state, transaction, operations, operation)
deadline = Time.iso8601(transaction.fetch("deadline_at"))
command = command_for(operation, transaction)
status = if operation == "arch-update"
  execute_yay_as_owner(command, deadline, state, id)
else
  execute_fixed(command, deadline)
end
fail_closed("#{operation} failed with status #{status}", status.zero? ? 1 : status) unless status.zero?
state["next_index"] = index + 1
state["terminal"] = state["next_index"] >= operations.length
atomic_root_json(state_path(id), state)
exit(0)

#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../lib/soul_core/conversation_memory_store"
require_relative "../lib/soul_core/conversation_observation_store"
require_relative "../lib/soul_core/core_orchestration_service"
require_relative "../lib/soul_core/env_loader"
require_relative "../lib/soul_core/memory_audit_journal_service"
require_relative "../lib/soul_core/memory_autonomous_lifecycle_service"
require_relative "../lib/soul_core/memory_core_aware_worker"
require_relative "../lib/soul_core/memory_core_aware_worker_deployment"
require_relative "../lib/soul_core/memory_exact_duplicate_consolidation_service"
require_relative "../lib/soul_core/memory_lifecycle_admission_service"
require_relative "../lib/soul_core/memory_lifecycle_maintenance_service"
require_relative "../lib/soul_core/memory_local_proposal_synthesizer"
require_relative "../lib/soul_core/memory_observation_derivation_service"

root = File.expand_path("..", __dir__)
SoulCore::EnvLoader.load(File.join(root, ".env"))
command = ARGV.shift.to_s

deployment = SoulCore::MemoryCoreAwareWorkerDeployment.new(root: root)
if %w[plan install deployment-status uninstall].include?(command)
  result = case command
           when "plan" then deployment.plan
           when "install" then deployment.install(confirmation: ARGV.shift.to_s, expected_digest: ARGV.shift.to_s)
           when "deployment-status" then deployment.status
           when "uninstall" then deployment.uninstall(confirmation: ARGV.shift.to_s)
           end
else
  observations = SoulCore::ConversationObservationStore.new(root: root)
  memories = SoulCore::ConversationMemoryStore.new(root: root, create: false)
  audit = SoulCore::MemoryAuditJournalService.new(root: root, memory_store: memories)
  synthesizer = SoulCore::MemoryLocalProposalSynthesizer.new(root: root, env: ENV)
  derivations = SoulCore::MemoryObservationDerivationService.new(
    root: root, observation_store: observations, synthesizer: synthesizer,
    model_identity: { "provider" => "local", "model" => SoulCore::LocalDevelopmentModelClient::MODEL, "core" => "dev" }
  )
  admissions = SoulCore::MemoryLifecycleAdmissionService.new(
    root: root, derivation_service: derivations, observation_store: observations,
    memory_store: memories, audit_service: audit
  )
  lifecycle = SoulCore::MemoryAutonomousLifecycleService.new(
    root: root, derivation_service: derivations, admission_service: admissions
  )
  consolidation = SoulCore::MemoryExactDuplicateConsolidationService.new(
    memory_store: memories, audit_service: audit
  )
  maintenance = SoulCore::MemoryLifecycleMaintenanceService.new(
    lifecycle_service: lifecycle, consolidation_service: consolidation
  )
  cores = SoulCore::CoreOrchestrationService.new(root: root, env: ENV)
  worker = SoulCore::MemoryCoreAwareWorker.new(
    root: root, lifecycle_service: maintenance, core_status: -> { cores.status }
  )
  result = case command
           when "run" then worker.run
           when "status" then worker.status
           else
             { "ok" => false, "lifecycle_state" => "awaiting_input",
               "reason" => "Usage: soul-memory-lifecycle-worker run|status|plan|install CONFIRM DIGEST|deployment-status|uninstall CONFIRM",
               "content_included" => false }
           end
end

puts JSON.pretty_generate(result)
exit(result["ok"] ? 0 : 1)

#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../lib/soul_core/env_loader"
require_relative "../lib/soul_core/memory_live_qualification_service"

command = ARGV.shift.to_s
root = File.expand_path("..", __dir__)
SoulCore::EnvLoader.load(File.join(root, ".env"))
service = SoulCore::MemoryLiveQualificationService.new(root: root, env: ENV)
result = case command
         when "status" then service.status
         when "derive" then service.derive(request_id: ARGV.shift.to_s)
         when "admit" then service.admit(request_id: ARGV.shift.to_s)
         when "retrieve" then service.retrieve(query: ARGV.join(" "))
         when "rollback" then service.rollback(transaction_id: ARGV.shift.to_s)
         else
           { "ok" => false, "lifecycle_state" => "awaiting_input",
             "reason" => "Usage: soul-memory-live-qualification status|derive REQUEST_ID|admit REQUEST_ID|retrieve QUERY|rollback TRANSACTION_ID",
             "content_included" => false }
         end
puts JSON.pretty_generate(result)
exit(result["ok"] ? 0 : 1)

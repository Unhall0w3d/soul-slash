#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

options = {}
OptionParser.new do |parser|
  parser.on("--root PATH") { |value| options[:root] = value }
  parser.on("--transaction PATH") { |value| options[:transaction] = value }
  parser.on("--mode MODE") { |value| options[:mode] = value }
end.parse!

abort "root is required" if options[:root].to_s.empty?
abort "transaction is required" if options[:transaction].to_s.empty?
abort "mode is invalid" unless %w[rehearsal live live_reboot].include?(options[:mode])

root = File.expand_path(options.fetch(:root))
$LOAD_PATH.unshift(File.join(root, "lib"))
require "soul_core/maintenance_transaction_runner"
require "soul_core/maintenance_fleet_status_service"

result = SoulCore::MaintenanceTransactionRunner.new(root: root).run(
  transaction_path: options.fetch(:transaction),
  mode: options.fetch(:mode)
)
if result && result["lifecycle_state"] == "complete" && options[:mode] == "live"
  begin
    SoulCore::MaintenanceFleetStatusService.new(root: root).collect
  rescue StandardError => error
    warn "Fleet status refresh requires review: #{error.class}"
  end
end
exit(result && %w[complete awaiting_login].include?(result["lifecycle_state"]) ? 0 : 1)

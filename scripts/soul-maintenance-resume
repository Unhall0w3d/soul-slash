#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

options = {}
OptionParser.new do |parser|
  parser.on("--root PATH") { |value| options[:root] = value }
end.parse!
abort "root is required" if options[:root].to_s.empty? || !ARGV.empty?

root = File.expand_path(options.fetch(:root))
$LOAD_PATH.unshift(File.join(root, "lib"))
require "soul_core/maintenance_session_restorer"
require "soul_core/maintenance_fleet_status_service"
require "soul_core/env_loader"

SoulCore::EnvLoader.load(File.join(root, ".env"))

result = SoulCore::MaintenanceSessionRestorer.new(root: root).run
begin
  SoulCore::MaintenanceFleetStatusService.new(root: root).collect
rescue StandardError => error
  warn "Fleet status refresh requires review: #{error.class}"
end
puts result.fetch("reason")
exit(result["lifecycle_state"] == "failed" ? 1 : 0)

# Soul/ portable local configuration template.
#
# Copy this file to `.env` and set only values needed on this machine.
# `.env` is ignored by git. Never commit credentials.
# Inspect the effective typed configuration with:
#   ruby bin/soul config show
# Validate it with:
#   ruby bin/soul config validate

# Preferred conversation provider. Leave blank to select the first configured
# eligible local provider.
# Values: local.openai_compatible, local.ollama, cloud.openai_compatible
SOUL_CONVERSATION_PROVIDER=
SOUL_CONVERSATION_MODE=auto
SOUL_ALLOW_CLOUD_CONVERSATION=false

# Conversation bounds.
SOUL_CONVERSATION_MAX_MESSAGES=12
SOUL_CONVERSATION_MAX_CHARACTERS=24000
SOUL_CONVERSATION_MAX_TOOL_STEPS=4
SOUL_CONVERSATION_TEMPERATURE=0.65
SOUL_CONVERSATION_MAX_OUTPUT_TOKENS=1024
SOUL_CONVERSATION_TIMEOUT_SECONDS=120

# Local OpenAI-compatible provider, including llama.cpp servers.
# Set the model identifier exposed by your own server.
SOUL_LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8082/v1
SOUL_LOCAL_OPENAI_MODEL=
# Use "auto" with a v3 runtime profile inventory so each manually selected
# llama.cpp or Ollama profile receives the correct bounded request shape. Use
# "ollama" for a fixed Ollama endpoint; leave blank for fixed llama.cpp.
SOUL_LOCAL_OPENAI_DIALECT=auto

# Optional authenticated dashboard control for existing allowlisted systemd user
# model services. Without a private profiles file, the single-service values
# remain compatible. This never installs or enables a service and has no
# automatic load, unload, or switch behavior. llama.cpp must expose /slots.
SOUL_MODEL_RUNTIME_CONTROL=0
SOUL_MODEL_RUNTIME_SERVICE=llama-server.service
SOUL_MODEL_RUNTIME_SLOTS_URL=http://127.0.0.1:8082/slots
SOUL_MODEL_RUNTIME_PROFILE=amd-gemma
SOUL_MODEL_RUNTIME_PROFILES_FILE=

# Local Ollama provider. Set the model installed on your own machine.
OLLAMA_HOST=http://127.0.0.1:11434
SOUL_OLLAMA_MODEL=

# Optional cloud OpenAI-compatible provider. Credentials belong only in the
# ignored `.env` or process environment. Credential presence does not enable
# cloud conversation; SOUL_ALLOW_CLOUD_CONVERSATION must also be true.
SOUL_CLOUD_OPENAI_BASE_URL=
SOUL_CLOUD_OPENAI_MODEL=
SOUL_CLOUD_OPENAI_CREDENTIAL_ENV=SOUL_CLOUD_OPENAI_API_KEY
# SOUL_CLOUD_OPENAI_API_KEY=

# Bounded artifact creation.
SOUL_ARTIFACT_APPROVAL_TTL_SECONDS=900
SOUL_ARTIFACT_MAX_OUTPUT_TOKENS=4096

# Optional bounded public-web research. DuckDuckGo Instant Answer lookup needs
# no configuration and is used only for narrow orientation. Deeper research
# uses the selected provider. SearXNG may use loopback HTTP, or the exact private
# LAN endpoint when SOUL_WEB_ALLOW_PRIVATE_SEARXNG=true. Public endpoints require
# HTTPS. Provider addresses and credentials remain only in `.env`.
# Values: searxng, brave
SOUL_WEB_SEARCH_PROVIDER=
SOUL_WEB_SEARXNG_URL=
SOUL_WEB_ALLOW_PRIVATE_SEARXNG=false
# SOUL_WEB_BRAVE_API_KEY=

# Reserved for the future separately approved foreground dashboard. These
# values do not start a listener. Phase 12 accepts loopback binding only.
SOUL_DASHBOARD_BIND_HOST=127.0.0.1
SOUL_DASHBOARD_PORT=4567
# Optional exact HTTPS reverse-proxy origin. This does not widen Soul's bind.
SOUL_DASHBOARD_PUBLIC_ORIGIN=

# Optional encrypted local recovery target. The repository password is
# deliberately not supported in `.env`; Administration asks for it per page
# session and passes it only to one bounded restic child operation.
SOUL_BACKUP_MOUNT=/mnt/soul-backup
SOUL_BACKUP_REPOSITORY=/mnt/soul-backup/restic
SOUL_BACKUP_REPLICA_REPOSITORY=sftp:crucible-maintenance:/srv/soul-backup/restic
SOUL_BACKUP_REPLICA_SSH_ALIAS=crucible-maintenance
SOUL_BACKUP_REPLICA_TARGET_PATH=/srv/soul-backup/restic
SOUL_BACKUP_REPLICA_OWNER=souladmin
SOUL_BACKUP_REPLICA_SSH_CONFIG=~/.ssh/config
SOUL_BACKUP_MAX_REPACK_SIZE=4G

# Class-5 Guided Maintenance remains preview/rehearsal-only by default.
# Set true only for one separately reviewed, supervised A2 live-update gate.
# Native A2 uses a visible terminal, asks for sudo once, and cannot reboot.
# Passwordless mode remains unavailable unless the separately reviewed,
# digest-bound root-owned fixed-operation authority is installed exactly.
SOUL_MAINTENANCE_A2_LIVE=false
SOUL_MAINTENANCE_A3_LIVE=false
SOUL_MAINTENANCE_PASSWORDLESS=false
SOUL_MAINTENANCE_DISPLAY_RECOVERY_SCRIPT=
SOUL_MAINTENANCE_REMOTE_LIVE=false

# Fleet display addresses are local deployment facts, not public defaults.
# Forge and Pi-hole collection still use their fixed reviewed SSH aliases.
# Keep private addresses in ignored `.env`; labels may use deployment-specific
# names while the stable internal IDs and functional roles remain unchanged.
SOUL_FLEET_WORKSTATION_ADDRESS=local
SOUL_FLEET_WORKSTATION_LABEL=Workstation
SOUL_FLEET_FORGE_ADDRESS=proxmox-maintenance
# Enrolled Proxmox hosts remain inventory-only unless this separate authority
# switch is enabled and their reviewed SSH alias exactly matches this value.
SOUL_FLEET_FOUNDRY_CONTROL_ENABLED=false
SOUL_FLEET_FOUNDRY_ADDRESS=foundry
SOUL_FLEET_FOUNDRY_LABEL=Foundry
SOUL_FLEET_FOUNDRY_SSH_ALIAS=foundry
SOUL_FLEET_PIHOLE_ADDRESS=pihole-maintenance
SOUL_FLEET_PIHOLE_LABEL=Pi-hole

# Optional status-only Cisco 8851/Webex Calling inventory. Enabling this adds
# one bounded ICMP reachability probe per fleet collection. It does not inspect
# line identity, call history, registration, firmware, or device logs and does
# not add Maintenance/Reboot controls. Prefer a DHCP reservation for a stable
# address. Keep the real LAN address only in ignored `.env`.
SOUL_FLEET_CISCO_PHONE_ENABLED=false
SOUL_FLEET_CISCO_PHONE_ADDRESS=
SOUL_FLEET_CISCO_PHONE_LABEL=Cisco 8851

# Optional Chat push-to-talk transcription overrides. The public default shares
# the pinned CPU whisper.cpp runtime installed by `make
# voice-transcription-install` under ~/.local/share/soul/music/transcription.
# A custom model value must exactly match an entry in the selected manifest.
SOUL_VOICE_TRANSCRIPTION_ROOT=
SOUL_VOICE_TRANSCRIPTION_MANIFEST=
SOUL_VOICE_TRANSCRIPTION_MODEL=ggml-small.en.bin

# Optional Chat voice-output overrides. The default is one bounded CPU-only
# Supertonic 3 process per explicit Speak click; no TTS server remains resident.
# The default voice must exactly match F1-F5 or M1-M5 in the selected manifest.
SOUL_VOICE_SYNTHESIS_ROOT=
SOUL_VOICE_SYNTHESIS_MANIFEST=
SOUL_VOICE_SYNTHESIS_VOICE=F3
SOUL_VOICE_SYNTHESIS_SPEED=1.0
SOUL_VOICE_EXPRESSIVE_ROOT=
SOUL_VOICE_EXPRESSIVE_MANIFEST=

# Optional visible persistent voice application. The exact local wake detector
# is active only while its window is open. Closing the window terminates
# microphone capture and every child process.
SOUL_VOICE_PRESENCE_ROOT=
SOUL_VOICE_PRESENCE_MANIFEST=
SOUL_VOICE_PRESENCE_SOURCE=effect_output.soul-rnnoise

# Optional external Markdown knowledge vault. Obsidian may open this directory
# as the human surface, but Soul uses the ordinary files directly. Use an
# absolute path or a path beginning with ~/. The vault is not canonical memory,
# is never watched, and is never synchronized automatically.
SOUL_KNOWLEDGE_VAULT_PATH=

# Existing foreground local-model setup scripts also consume the following
# compatibility values. Choose a provider and supply model file/URL values only
# when using those scripts. Relative model storage remains machine-portable.
# Values: llamacpp, ollama
SOUL_RUNTIME_PROVIDER=
SOUL_OPENAI_BASE_URL=http://127.0.0.1:8082/v1
SOUL_MODEL_ALIAS=
SOUL_MODEL_DIR=./models
SOUL_MODEL_FILE=
SOUL_MODEL_URL=
SOUL_LLAMA_HOST=127.0.0.1
SOUL_LLAMA_PORT=8082
SOUL_CTX_SIZE=4096
SOUL_N_PREDICT=2048
SOUL_GPU_LAYERS=999
SOUL_CACHE_TYPE_K=f16
SOUL_CACHE_TYPE_V=f16
SOUL_FLASH_ATTN=off
SOUL_REASONING_FORMAT=deepseek
SOUL_USE_JINJA=true

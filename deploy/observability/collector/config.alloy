local.file "ingest_password" {
  filename  = "/etc/soul-observability/ingest-password"
  is_secret = true
}

prometheus.exporter.unix "host" {
  include_exporter_metrics = false
  set_collectors = [
    "cpu", "diskstats", "filesystem", "hwmon", "loadavg", "meminfo",
    "netclass", "netdev", "netstat", "os", "stat", "systemd", "time",
    "uname", "vmstat",
  ]
  systemd {
    task_metrics   = false
    enable_restarts = true
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.central.receiver]
}

prometheus.remote_write "central" {
  external_labels = {
    device_id   = sys.env("SOUL_DEVICE_ID"),
    role        = sys.env("SOUL_DEVICE_ROLE"),
    platform    = sys.env("SOUL_PLATFORM"),
    environment = sys.env("SOUL_ENVIRONMENT"),
  }

  endpoint {
    url = sys.env("OBSERVABILITY_URL") + "/api/v1/write"
    basic_auth {
      username = "ingest"
      password = local.file.ingest_password.content
    }
    tls_config {
      ca_file = "/etc/soul-observability/ca.crt"
    }
  }
}

loki.relabel "maintenance" {
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "soul-maintenance-fleet-status.service|soul-maintenance-resume.service"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "priority"
  }

  forward_to = [loki.process.maintenance.receiver]
}

loki.source.journal "maintenance" {
  max_age = "24h"
  labels = {
    job         = "soul-maintenance",
    device_id   = sys.env("SOUL_DEVICE_ID"),
    role        = sys.env("SOUL_DEVICE_ROLE"),
    environment = sys.env("SOUL_ENVIRONMENT"),
  }
  forward_to = [loki.relabel.maintenance.receiver]
}

loki.process "maintenance" {
  stage.replace {
    expression = "(?s).+"
    replace    = "bounded maintenance lifecycle event"
  }
  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = sys.env("OBSERVABILITY_URL") + "/loki/api/v1/push"
    basic_auth {
      username = "ingest"
      password = local.file.ingest_password.content
    }
    tls_config {
      ca_file = "/etc/soul-observability/ca.crt"
    }
  }
}
